<Project>
  <!-- MSBuild stops at the first Directory.Build.props it finds walking up, so without
       this import the file would hide src4\Directory.Build.props from every RhinoCycles
       project. That one carries tree-wide settings - among them
       AccelerateBuildsInVisualStudio=false: Visual Studio's build acceleration copies and
       prunes files itself in the shared Plug-ins folder, which made
       RhinoCyclesKernelCompiler.exe disappear from bin\<Config>\Plug-ins. Chain to the
       parent first, then add ours. -->
  <PropertyGroup>
    <_RhinoParentDirectoryBuildProps>$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))</_RhinoParentDirectoryBuildProps>
  </PropertyGroup>
  <Import Project="$(_RhinoParentDirectoryBuildProps)" Condition="'$(_RhinoParentDirectoryBuildProps)' != ''" />
  <PropertyGroup>
		<!-- Since we have two .csproj's in the same folder we use a separate intermediate path for each -->
		<!-- Also, be nice to those that compile on multiple OS' with the same source -->
		<BaseIntermediateOutputPath>obj\$(OS)\$(MSBuildProjectName)</BaseIntermediateOutputPath>
		<DefaultItemExcludes>obj\*</DefaultItemExcludes>
  </PropertyGroup>
</Project>
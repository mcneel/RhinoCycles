  <!--
    Cycles comes from big_libs, always. A +Cycles solution configuration makes
    ccycles.vcxproj rebuild it and install it into big_libs first, so the copy below
    is the single route into the output either way.

    Payload folders under big_libs\RhinoCycles\ccycles\win, most preferred first:

      local    Any configuration, while it is newer than release. Written by a
               narrow build_cycles.ps1 build - kernels for this machine's GPUs only -
               so that it never overwrites the committed payload. Gitignored.
      debug    Debug only, when it exists. Written by a local Debug+Cycles build
               (RelWithDebInfo, so ccycles can be stepped into). Gitignored.
      release  Committed. Used otherwise.

    The freshness test keeps an old local build from being deployed for ever: git
    touches the committed ccycles.dll when a pull changes it, so a newer committed
    payload wins, and rebuilding +Cycles makes the local one win again. The debug
    payload has no such test on purpose: whoever built it wants to step into
    ccycles.
  -->
  <PropertyGroup>
    <!--
      From this project's directory, not $(SolutionDir), so the path is the same
      whichever solution is built.
      RhinoCycles -> RDK -> Plug-ins -> rhino4 -> src4 -> repo root.
    -->
    <CyclesPayloadRoot>$(MSBuildProjectDirectory)\..\..\..\..\..\big_libs\RhinoCycles\ccycles\win</CyclesPayloadRoot>
  </PropertyGroup>

  <!--
    The payload is chosen when the target runs, not at evaluation: in a solution
    build evaluation happens before ccycles.vcxproj has installed anything, so
    Exists() would miss a payload built by that same build.
  -->
  <Target Name="SelectCyclesPayload" Condition="'$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <CyclesPayloadPath>$(CyclesPayloadRoot)\release</CyclesPayloadPath>
      <CyclesPayloadPath Condition="'$(Configuration)' == 'Debug' And Exists('$(CyclesPayloadRoot)\debug\ccycles.dll')">$(CyclesPayloadRoot)\debug</CyclesPayloadPath>

      <!--
        File.GetLastWriteTime returns 1601-01-01 for a path that does not exist
        rather than failing, so the release side needs no Exists guard - a missing
        committed payload just makes any local one newer, which is the right answer.
      -->
      <CyclesLocalTicks Condition="Exists('$(CyclesPayloadRoot)\local\ccycles.dll')">$([System.IO.File]::GetLastWriteTime('$(CyclesPayloadRoot)\local\ccycles.dll').Ticks)</CyclesLocalTicks>
      <CyclesReleaseTicks>$([System.IO.File]::GetLastWriteTime('$(CyclesPayloadRoot)\release\ccycles.dll').Ticks)</CyclesReleaseTicks>
      <CyclesPayloadPath Condition="'$(CyclesLocalTicks)' != '' And $(CyclesLocalTicks) &gt; $(CyclesReleaseTicks)">$(CyclesPayloadRoot)\local</CyclesPayloadPath>
    </PropertyGroup>
  </Target>

  <!--
    AfterTargets="Build" runs this on every build of this project, including no-op
    ones, and the payload is over 300 MB, so XCopy /D copies only what is newer than
    the destination (and returns 0 when everything is up to date). No /S: top-level
    files only. lib and source are mirrored into RhinoCycles\ by robocopy.

    The command sits in a property because XML folds the newlines in an attribute
    into spaces; property expansion happens after parsing and keeps them.
  -->
  <Target Name="DeployCyclesPayload" AfterTargets="Build" DependsOnTargets="SelectCyclesPayload" Condition="'$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <CyclesDeployCommand>
      XCopy "$(CyclesPayloadPath)\*" "$(OutputPath)." /Y /D /I /Q
      rem /MIR on lib and source so kernels/sources dropped from the payload (e.g. an arch
      rem no longer built, or a kernel header removed upstream) do not linger and get
      rem loaded. XCopy /D only ever adds and overwrites, so it could not remove them.
      rem robocopy is itself incremental, so this keeps the no-op build cheap.
      robocopy "$(CyclesPayloadPath)\lib" "$(OutputPath)RhinoCycles\lib" /MIR /NJH /NJS /NFL /NDL /NP
      if errorlevel 8 exit /b 1
      robocopy "$(CyclesPayloadPath)\source" "$(OutputPath)RhinoCycles\source" /MIR /NJH /NJS /NFL /NDL /NP
      if errorlevel 8 exit /b 1
      exit /b 0
      </CyclesDeployCommand>
    </PropertyGroup>
    <Exec WorkingDirectory="$(OutDir)" Command="$(CyclesDeployCommand)" />
  </Target>

  <!--
    Say which payload was deployed: it decides whether ccycles can be stepped into.
    A Message, not a Warning - the solution builds with zero warnings, and release
    Cycles under a Debug Rhino is the normal case.

    The no-debug-payload hint is opt-in through the RHINOCYCLESDEV environment
    variable, which nothing else reads any more. Only a Debug+Cycles build writes a
    debug payload, so without the opt-in the hint would show on every developer's
    Debug build.
  -->
  <Target Name="ReportCyclesPayload" AfterTargets="DeployCyclesPayload" DependsOnTargets="SelectCyclesPayload" Condition="'$(OS)' == 'Windows_NT'">
    <Message Importance="high" Text="RhinoCycles: deployed Cycles payload from $(CyclesPayloadPath)" />

    <!-- Explains why a local +Cycles build stopped being used after a pull. -->
    <Message Importance="high"
             Condition="'$(CyclesLocalTicks)' != '' And $(CyclesLocalTicks) &lt;= $(CyclesReleaseTicks)"
             Text="RhinoCycles: your local Cycles payload is older than the committed one, so the committed one was used. Rebuild a +Cycles configuration to use yours again." />
    <Message Importance="high"
             Condition="'$(Configuration)' == 'Debug' And '$(RHINOCYCLESDEV)' != '' And !Exists('$(CyclesPayloadRoot)\debug\ccycles.dll')"
             Text="RhinoCycles: no debug Cycles payload in big_libs, so this Debug build uses release Cycles and ccycles cannot be stepped into. Build Debug+Cycles once to produce one." />
  </Target>

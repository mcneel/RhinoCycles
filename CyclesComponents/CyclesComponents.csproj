<Project Sdk="Microsoft.NET.Sdk">
  <!-- Grasshopper 2 library of Cycles shader nodes, read from the Cycles node registry. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\..\..\..\RhinoProjectPropertySheets\Rhino.CS.PlugIn.props" />
  <PropertyGroup>
    <OutputPath>$(ComponentOutputPath)</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)\$(TargetFramework)\</IntermediateOutputPath>
    <TargetExt>.rhp</TargetExt>
    <AssemblyName>G2CyclesComponents</AssemblyName>
    <AssemblyTitle>Cycles</AssemblyTitle>
    <Description>Cycles shader nodes, read from the Cycles node registry.</Description>
    <!-- csycles is net48 only; RhinoCyclesCore uses it under net8.0 the same way. -->
    <NoWarn>$(NoWarn);NU1702</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\grasshopper2\Grasshopper2\Grasshopper2.csproj" ExcludeAssets="all" Private="False" />
    <ProjectReference Include="..\..\..\grasshopper2\GrasshopperIO\GrasshopperIO.csproj" ExcludeAssets="all" Private="False" />
    <ProjectReference Include="..\..\..\..\..\DotNetSDK\rhinocommon\dotnet\RhinoCommon.csproj" Private="False" ExcludeAssets="all" />
    <ProjectReference Include="..\..\..\..\..\DotNetSDK\Eto\src\Eto\Eto.csproj" Private="False" ExcludeAssets="all" />
    <!-- RhinoCycles ships csycles, and the ccycles it calls, in Plug-ins. -->
    <ProjectReference Include="..\..\cycles-core\src\csycles\csycles.csproj" Private="False" ExcludeAssets="all" />
  </ItemGroup>
</Project>
